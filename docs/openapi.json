          "label": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        }
      },
      "CreateImage": {
        "type": "object",
        "description": "Register an already built image; image builds are not mutations of this resource.",
        "required": [
          "idempotency_key",
          "name",
          "tag"
