            ]
          }
        }
      },
      "CreateTurn": {
        "type": "object",
        "required": [
          "idempotency_key",
          "session_id"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          }
        }
      },
