          "idempotency_key",
          "name",
          "description",
          "image"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              }
            ]
          },
          "idempotency_key": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "system_prompt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateCredential": {
        "type": "object",
