                "properties": {
                  "position": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string"
                  },
                  "turn_id": {
                    "type": "string"
                  }
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "token_delta"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "data",
              "type"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "health"
                ],
                "properties": {
