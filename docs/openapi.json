        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "session_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "CreateSession": {
        "type": "object",
        "required": [
          "idempotency_key"
        ],
        "properties": {
          "agent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReasoningEffort"
