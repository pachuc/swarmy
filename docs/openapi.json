                  }
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "service_status_changed"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "data",
              "type"
            ],
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "node"
                ],
                "properties": {
                  "node": {
                    "$ref": "#/components/schemas/Node"
                  }
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "node_status_changed"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Stored events without a dedicated public projection retain their original data.",
            "required": [
              "data",
              "type"
            ],
            "properties": {
              "data": {
                "type": "object",
                "description": "Stored events without a dedicated public projection retain their original data.",
                "required": [
                  "record"
                ],
                "properties": {
                  "record": {}
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "store_record"
                ]
              }
            }
          }
