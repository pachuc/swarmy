                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/ImageRef"
          },
          "main_session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "system_prompt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "`provider_text` preserves the original provider error without rewriting it.",
