#!/usr/bin/env python3
"""Fake OpenTofu for the provisioner reconcile tests.

The state file has OpenTofu's shape (version 4, managed resources with
instances, root outputs), so the provisioner reads it the way it reads real
state. Marker files next to this script inject failures.
"""
import json
import os
import sys

FIXTURE = os.path.dirname(os.path.abspath(sys.argv[0]))
STATE = "terraform.tfstate"
CREDENTIALS = [
    "HCLOUD_TOKEN", "SCW_ACCESS_KEY", "SCW_SECRET_KEY", "SCW_DEFAULT_PROJECT_ID",
    "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_REGION", "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_CONFIG_FILE", "AWS_EC2_METADATA_DISABLED",
]


def log(line):
    with open(os.path.join(FIXTURE, "tofu.log"), "a") as file:
        file.write(line + "\n")


def marker(name):
    return os.path.exists(os.path.join(FIXTURE, name))


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def resource(kind, count):
    keys = [None] if count is None else list(range(count))
    return {
        "mode": "managed",
        "type": kind,
        "name": "this",
        "instances": [{} if key is None else {"index_key": key} for key in keys],
    }


def write_state(swarm, group, servers, ips=None, outputs=True):
    ips = servers if ips is None else ips
    resources = [resource("scaleway_instance_security_group", None)]
    if ips:
        resources.append(resource("scaleway_instance_ip", ips))
    if servers:
        resources.append(resource("scaleway_instance_server", servers))
    state = {"version": 4, "resources": resources, "outputs": {}}
    if outputs:
        machines = [
            {"name": f"{swarm}-{group}-{i}", "public_ipv4": f"203.0.113.{10 + i}",
             "public_ipv6": None, "private_ip": None, "ssh_user": "root"}
            for i in range(1, servers + 1)
        ]
        state["outputs"] = {"machines": {"value": machines}, "network_id": {"value": None}}
    with open(STATE, "w") as file:
        json.dump(state, file)


def read_state():
    if not os.path.exists(STATE):
        return {"version": 4, "resources": [], "outputs": {}}
    with open(STATE) as file:
        return json.load(file)


def main():
    command = sys.argv[1]
    if command == "write-state":
        # Test helper, not an OpenTofu command: write-state SWARM GROUP COUNT.
        write_state(sys.argv[2], sys.argv[3], int(sys.argv[4]))
        return
    log(f"call {os.path.basename(os.getcwd())} {command}")
    for name in CREDENTIALS:
        if os.environ.get(name):
            log(f"env {name}")
    if command == "apply":
        with open("swarmy.tfvars.json") as file:
            variables = json.load(file)
        swarm, group, count = variables["swarm"], variables["group"], variables["machine_count"]
        log(f"apply machine_count={count}")
        open(os.path.join(FIXTURE, "applied"), "w").close()
        if marker("fail-apply"):
            fail("injected apply failure")
        if marker("fail-apply-partial"):
            machines = read_state()["outputs"].get("machines", {}).get("value", [])
            write_state(swarm, group, len(machines) + 1)
            fail("injected partial apply failure")
        if marker("fail-apply-leak"):
            # A quota refusal after the security group and IPs exist: no servers, no outputs.
            write_state(swarm, group, 0, ips=count, outputs=False)
            fail("Error: quota exceeded")
        write_state(swarm, group, count)
    elif command == "destroy":
        with open(STATE, "w") as file:
            json.dump({"version": 4, "resources": [], "outputs": {}}, file)
    elif command == "output":
        if marker("applied") and marker("fail-output"):
            fail("injected output failure")
        print(json.dumps(read_state()["outputs"]))


main()
