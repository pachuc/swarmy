#!/bin/bash
root=$(dirname "$(dirname "$0")")
last="${@: -1}"
printf '%s\n' "$last" >> "$root/ssh-commands"
printf '%s\n' "$*" >> "$root/ssh-full-commands"
case "$last" in
  true) exit 0 ;;
  'bash -s') file="$root/piped-"$(ls "$root/piped-"* 2>/dev/null | wc -l); cat > "$file"; printf '%s\n' "$*" > "$file.args";
    if grep -q '^list_installed_control_units$' "$file"; then printf 'swarmy-api.service\n'; elif grep -q '^drain_node_agent ' "$file"; then if [ -f "$root/fake/drain-line" ]; then cat "$root/fake/drain-line"; else printf 'drain {"stopped":true,"busy":[],"unreleased":[]}\n'; fi; else printf '/home/fake\n'; fi ;;
  'uname -m') /usr/bin/uname -m ;;
  *'swarmy-core --version'*) printf 'swarmy-core test\n' ;;
  *'journalctl --unit swarmyd --follow --no-pager --lines 100'*) if [ -e "$root/fail-journal" ]; then echo journal-failed >&2; exit 23; fi; echo remote-output ;;
  *'remote-upgrade.sh'*) if [ -e "$root/fail-upgrade-primary" ] && [[ " $* " == *203.0.113.10* ]]; then echo upgrade-failed >&2; exit 23; fi; printf '{"node":"","changed":[],"restarted":[],"elapsed_seconds":0}\n' ;;
  'cat ~swarmy/swarmy/.dev/fdb.cluster') printf 'test:test@127.0.0.1:4500\n' ;;
  *'cat ~swarmy/swarmy/.swarmy/tunnel-key.pub') printf 'ssh-ed25519 AAAATEST test\n' ;;
  'cat /etc/ssh/ssh_host_ed25519_key.pub') printf 'ssh-ed25519 AAAATEST test\n' ;;
  'cat ~swarmy/swarmy/.swarmy/config.toml') printf '[api]\ntoken = "node-token"\n' ;;
  'sudo -n sh -c '*) cat >/dev/null ;;
  *) echo remote-output ;;
esac
