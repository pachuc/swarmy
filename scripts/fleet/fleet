#!/usr/bin/env python3
"""Operate tasky tasks on a pool of long-lived Swarmy worker agents."""
import argparse
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import tomllib
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[2]
CONFIG = Path(os.environ.get("FLEET_CONFIG") or Path(__file__).with_name("fleet.toml"))
AGENTS = ROOT / "AGENTS.md"
URL = re.compile(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+")
TARGET_LIMIT_GIB = 20


def command(args, *, input=None):
    result = subprocess.run(args, input=input, text=True, capture_output=True, check=False)
    if result.returncode:
        raise RuntimeError(f"{' '.join(args[:3])} failed: {result.stderr.strip()}")
    return result.stdout


def records(output):
    return [json.loads(line) for line in output.splitlines() if line.strip()]


def one(output):
    values = records(output)
    if len(values) != 1:
        raise RuntimeError("expected one JSON record")
    return values[0]


def load():
    if not CONFIG.exists():
        raise RuntimeError(f"create {CONFIG} from fleet.example.toml")
    if CONFIG.stat().st_mode & 0o077:
        raise RuntimeError(f"{CONFIG} must have owner-only permissions (chmod 600)")
    data = tomllib.loads(CONFIG.read_text())
    for key in ("remote", "github_token", "repo"):
        if not data.get(key):
            raise RuntimeError(f"{CONFIG}: missing {key}")
    data.setdefault("workers", 4)
    return data


def state_path(config):
    return Path(config.get("state_dir", ROOT / ".dev" / "fleet"))


def save(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as file:
        json.dump(value, file)
        file.write("\n")


def task_suffix(task_id):
    suffix = task_id.rsplit("-", 1)[-1].lower()
    if not re.fullmatch(r"[a-z0-9]+", suffix):
        raise RuntimeError("task id must end in an alphanumeric suffix")
    return suffix


def task_fields(task):
    task = task.get("task", task)
    return (task.get("title") or "", task.get("body") or task.get("description") or "",
            task.get("test_plan") or task.get("testPlan") or "")


def prompt(task_id, task, config, branch):
    title, body, tests = task_fields(task)
    return f"""You are a long-lived swarmy development worker. Your computer persists between tasks, so keep it tidy: every task gets a fresh clone in its own directory, one new branch from master, and you leave nothing uncommitted behind.

Before starting this task:
1. mkdir -p ~/work. Remove every directory under ~/work except ~/work/{branch.split('/')[-1]}, if any exist.
2. If `du -sb ~/.cargo-target` reports more than {TARGET_LIMIT_GIB} GiB, run `cargo clean` from any clone (the shared target directory lives outside the clones).
3. Clone https://github.com/{config['repo']}.git into ~/work/{branch.split('/')[-1]}, and create branch {branch} from origin/master. Never reuse or force-push a branch.

You are executing tasky {task_id}: {title}.

Repository contract (AGENTS.md):
{AGENTS.read_text()}

Task body:
{body}

Test plan:
{tests}

Read the repository's AGENTS.md and docs/DESIGN.md before changing files. Implement only this task. Run cargo fmt --all --check, cargo test --workspace --locked with the dev stack from scripts/dev-stack.sh start and .dev/env sourced, and cargo clippy --workspace --all-targets --locked -- -D warnings. Work through the test plan, including the root-only suites AGENTS.md maps to the areas you changed. Commit with an imperative subject and a body explaining why. Push {branch} to origin. Open one pull request against master with a title containing tasky {task_id}. Its description must say what was built, list exact validation commands and results, and list test plan items not verified and why. Do not include credentials in logs, commits, or the PR. When you are done, stop the dev stack with scripts/dev-stack.sh stop, and finish by reporting the pull request URL in your last message.
"""


def swarmy(config, *args):
    return ["swarmy", "--remote", config["remote"], *args]


def tasky(*args, json_output=False):
    return ["tasky", *(["--json"] if json_output else []), "task", *args]


def workers_path(config):
    return state_path(config) / "workers.json"


def load_workers(config):
    path = workers_path(config)
    return json.loads(path.read_text()) if path.exists() else {}


def save_workers(config, workers):
    save(workers_path(config), workers)


def selection_args(args, config):
    provider = getattr(args, "provider", None) or config.get("provider")
    model = getattr(args, "model", None) or config.get("model")
    effort = getattr(args, "effort", None) or config.get("effort")
    if not provider or not model:
        raise RuntimeError("provider and model must be supplied or configured")
    selection = ["--provider", provider, "--model", model]
    if effort:
        selection += ["--effort", effort]
    return provider, model, effort, selection


def create_worker(name, config, selection, image):
    extra = ["--image", image] if image else []
    command(swarmy(config, "agent", "create", name, *extra, "--description", "fleet worker",
                   *selection, "--github-token-stdin"), input=config["github_token"] + "\n")


def worker_meta_path(config, name):
    return state_path(config) / (name + ".meta.json")


def worker_meta(config, name):
    path = worker_meta_path(config, name)
    return json.loads(path.read_text()) if path.exists() else {}


def pick_worker(config, selection, image, provider, model):
    """Prefer an idle worker created with the requested provider and model.

    A worker's selection is fixed when it is created (run --agent takes no
    overrides), so a task that asks for ChatGPT must not land on an
    OpenRouter worker. Any idle worker is used only when none matches and
    the pool is full."""
    workers = load_workers(config)
    idle = [name for name, assigned in sorted(workers.items()) if assigned is None]
    for name in idle:
        meta = worker_meta(config, name)
        if meta.get("provider") == provider and meta.get("model") == model:
            return name, workers
    if len(workers) < int(config["workers"]):
        name = f"worker-{len(workers) + 1}"
        create_worker(name, config, selection, image)
        workers[name] = None
        save_workers(config, workers)
        save(worker_meta_path(config, name), {"provider": provider, "model": model, "image": image})
        return name, workers
    if idle:
        name = idle[0]
        meta = worker_meta(config, name)
        print(f"note: {name} runs {meta.get('provider') or '?'}/{meta.get('model') or '?'}, not the requested "
              f"{provider}/{model}; pool is full", file=sys.stderr)
        return name, workers
    raise RuntimeError(f"all {len(workers)} workers are busy; release a task or raise workers in {CONFIG}")


def launch(args, config):
    suffix = task_suffix(args.task_id)
    branch = "swarmy/" + suffix
    path = state_path(config) / (suffix + ".json")
    if path.exists():
        raise RuntimeError(f"{args.task_id} already launched")
    task = one(command(tasky("show", args.task_id, json_output=True)))
    provider, model, effort, selection = selection_args(args, config)
    image = args.image or config.get("image")
    if image and ":" not in image:
        raise RuntimeError("image must be NAME:TAG, for example swarmy-dev:dev")
    worker, workers = pick_worker(config, selection, image, provider, model)
    log = state_path(config) / (suffix + ".jsonl")
    log.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with log.open("w") as stream:
        os.chmod(log, 0o600)
        # run --agent takes the agent's own provider, model, and effort and
        # rejects overrides, so selection only applies at worker creation.
        process = subprocess.Popen(swarmy(config, "run", "--agent", worker,
                                          "--json", prompt(args.task_id, task, config, branch)),
                                   stdout=stream, stderr=subprocess.DEVNULL,
                                   start_new_session=True)
    session = None
    for _ in range(100):
        if log.exists():
            for event in records(log.read_text()):
                if event.get("event") in ("session_created", "session_opened"):
                    session = event.get("session_id")
                    break
        if session or process.poll() is not None:
            break
        time.sleep(0.1)
    if not session:
        raise RuntimeError(f"run did not report a session id; inspect {log}")
    workers[worker] = args.task_id
    save_workers(config, workers)
    save(path, {"task_id": args.task_id, "worker": worker, "branch": branch,
                "session_id": session, "provider": provider, "model": model,
                "effort": effort, "started_at": datetime.now(timezone.utc).isoformat()})
    command(tasky("start", args.task_id))
    print(f"launched {args.task_id} on {worker} session={session}")


def assignment(config, task_id):
    suffix = task_suffix(task_id)
    path = state_path(config) / (suffix + ".json")
    if not path.exists():
        raise RuntimeError(f"no fleet launch for {task_id}")
    return path, json.loads(path.read_text())


def session_events(config, session_id):
    return records(command(swarmy(config, "session", "show", session_id, "--json")))


def state_for(session, events, log):
    wait = next((item for item in events if item.get("state") == "waiting_for_inference"), None)
    if wait:
        return "waiting for inference: " + "; ".join(wait.get("reasons", []))
    state = session.get("state") if session else None
    if state is None:
        return "unknown"
    if state in ("idle", "completed"):
        return "idle"
    outcomes = [item for item in log if item.get("event") == "run_outcome"]
    if outcomes and outcomes[-1].get("outcome") == "failed":
        return "failed"
    return "running"


def status(config):
    workers = load_workers(config)
    # session ls carries each session's state; session show prints selection, usage,
    # a waiting record when parked, and then the events, but not the record itself.
    sessions = {item["session_id"]: item
                for item in records(command(swarmy(config, "session", "ls", "--json")))
                if "session_id" in item and "state" in item}
    for name, task_id in sorted(workers.items()):
        detail = one(command(swarmy(config, "agent", "show", name, "--json")))
        session_id = detail.get("main_session")
        events = session_events(config, session_id) if session_id else []
        session = sessions.get(session_id)
        data = {}
        logged = []
        if task_id:
            suffix = task_suffix(task_id)
            assignment_path = state_path(config) / (suffix + ".json")
            data = json.loads(assignment_path.read_text()) if assignment_path.exists() else {}
            run_log = state_path(config) / (suffix + ".jsonl")
            logged = records(run_log.read_text()) if run_log.exists() else []
        state = state_for(session, events, logged) if task_id else "idle"
        started = data.get("started_at")
        elapsed = int((datetime.now(timezone.utc) - datetime.fromisoformat(started.replace("Z", "+00:00"))).total_seconds()) if started else 0
        print(f"{name}\t{task_id or '-'}\t{detail.get('provider') or '-'}\t{detail.get('model') or '-'}\t"
              f"{state}\t{elapsed}s\t${detail.get('cost_dollars', 0)}")


def last_message(events):
    messages = []
    for event in events:
        payload = event.get("message_appended") or event.get("inference_completed") or {}
        message = payload.get("message", {})
        if message.get("role") == "assistant":
            content = "".join(part.get("text", {}).get("text", "") for part in message.get("parts", []))
            if content:
                messages.append(content)
    return messages[-1] if messages else ""


def verify_pr(url, data, config, *, merged=False):
    parsed = urlparse(url)
    if parsed.hostname != "github.com" or parsed.path.split("/")[1:3] != config["repo"].split("/"):
        raise RuntimeError("PR URL is outside the configured repository")
    pr = one(command(["gh", "pr", "view", url, "--repo", config["repo"],
                      "--json", "url,state,baseRefName,headRefName"]))
    required_state = "MERGED" if merged else "OPEN"
    if (pr.get("state") != required_state or pr.get("baseRefName") != "master" or
            pr.get("headRefName") != data["branch"] or pr.get("url") != url):
        raise RuntimeError(f"PR is not {required_state.lower()} against master from {data['branch']}")


def collect(task_id, config):
    path, data = assignment(config, task_id)
    agent = one(command(swarmy(config, "agent", "show", data["worker"], "--json")))
    session_id = agent.get("main_session") or data["session_id"]
    message = last_message(session_events(config, session_id))
    match = URL.search(message)
    if not match:
        raise RuntimeError("worker's last message has no pull request URL")
    url = match.group(0)
    verify_pr(url, data, config)
    command(tasky("pr", task_id, url))
    command(tasky("test", task_id))
    data["pr_url"] = url
    save(path, data)
    print(url)


def resume(task_id, message, config):
    _, data = assignment(config, task_id)
    # A follow-up on the worker's main conversation continues the task.
    args = swarmy(config, "run", "--agent", data["worker"], "--json", message)
    result = subprocess.run(args, text=True, capture_output=True, check=False)
    with (state_path(config) / (task_suffix(task_id) + ".jsonl")).open("a") as log:
        log.write(result.stdout)
    if result.returncode:
        raise RuntimeError(f"follow-up failed: {result.stderr.strip()}")
    outcomes = [item for item in records(result.stdout) if item.get("event") == "run_outcome"]
    if outcomes and outcomes[-1].get("outcome") == "failed":
        raise RuntimeError(outcomes[-1].get("reason", "turn failed"))
    print(f"resumed {task_id}")


def release(task_id, config, *, force=False):
    path, data = assignment(config, task_id)
    if not force:
        if not data.get("pr_url"):
            raise RuntimeError("collect the pull request before releasing the worker, or pass --force")
        verify_pr(data["pr_url"], data, config, merged=True)
    workers = load_workers(config)
    if workers.get(data["worker"]) == task_id:
        workers[data["worker"]] = None
        save_workers(config, workers)
    path.unlink()
    print(f"released {data['worker']} from {task_id}")


def kill(task_id, config, timeout_seconds):
    _, data = assignment(config, task_id)
    agent = one(command(swarmy(config, "agent", "show", data["worker"], "--json")))
    session_id = agent.get("main_session") or data["session_id"]
    command(swarmy(config, "session", "interrupt", session_id))
    deadline = time.monotonic() + timeout_seconds
    while True:
        sessions = records(command(swarmy(config, "session", "ls", "--json")))
        session = next((item for item in sessions if item.get("session_id") == session_id and "state" in item), None)
        if session and session["state"] == "idle":
            break
        if time.monotonic() >= deadline:
            raise RuntimeError(f"session {session_id} did not reach Idle within {timeout_seconds} seconds; worker remains assigned")
        time.sleep(0.1)
    release(task_id, config, force=True)
    print(f"tasky task {task_id} is still in progress; the operator can relaunch or cancel it")


def reset(worker, config):
    workers = load_workers(config)
    if worker not in workers:
        raise RuntimeError(f"unknown worker {worker}")
    if workers[worker]:
        raise RuntimeError(f"{worker} still holds {workers[worker]}; release it first")
    command(swarmy(config, "agent", "delete", worker, "--yes"))
    del workers[worker]
    save_workers(config, workers)
    worker_meta_path(config, worker).unlink(missing_ok=True)
    print(f"deleted {worker}; the next launch recreates it from the image")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    launch_parser = sub.add_parser("launch", help="run a tasky task on an idle worker, creating one if the pool has room")
    launch_parser.add_argument("task_id")
    launch_parser.add_argument("--provider")
    launch_parser.add_argument("--model")
    launch_parser.add_argument("--effort")
    launch_parser.add_argument("--image", help="registered image as NAME:TAG for a newly created worker; default is the remote's default image")
    sub.add_parser("status", help="one line per worker: task, provider, model, state, elapsed, cost")
    sub.add_parser("collect", help="record the worker's pull request in tasky").add_argument("task_id")
    resume_parser = sub.add_parser("resume", help="send a follow-up message to the worker on this task")
    resume_parser.add_argument("task_id")
    resume_parser.add_argument("message")
    release_parser = sub.add_parser("release", aliases=["rm"], help="free the worker once the task's pull request is merged")
    release_parser.add_argument("task_id")
    release_parser.add_argument("--force", action="store_true", help="free the worker even without a merged pull request")
    kill_parser = sub.add_parser("kill", help="interrupt a task and free its worker after the session reaches Idle")
    kill_parser.add_argument("task_id")
    kill_parser.add_argument("--timeout-seconds", type=float, help="seconds to wait for Idle (default: config kill_timeout_seconds or 60)")
    sub.add_parser("reset", help="delete an idle worker and its disk; the next launch recreates it").add_argument("worker")
    args = parser.parse_args()
    try:
        config = load()
        if args.action == "launch":
            launch(args, config)
        elif args.action == "status":
            status(config)
        elif args.action == "collect":
            collect(args.task_id, config)
        elif args.action == "resume":
            resume(args.task_id, args.message, config)
        elif args.action in ("release", "rm"):
            release(args.task_id, config, force=args.force)
        elif args.action == "kill":
            seconds = args.timeout_seconds if args.timeout_seconds is not None else float(config.get("kill_timeout_seconds", 60))
            if not math.isfinite(seconds) or seconds <= 0:
                raise ValueError("kill timeout must be positive")
            kill(args.task_id, config, seconds)
        else:
            reset(args.worker, config)
    except (RuntimeError, OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"fleet: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
