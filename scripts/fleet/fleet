#!/usr/bin/env python3
"""Operate tasky tasks on a pool of long-lived Swarmy worker agents."""
import argparse
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import tomllib
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[2]
CONFIG = Path(os.environ.get("FLEET_CONFIG") or Path(__file__).with_name("fleet.toml"))
AGENTS = ROOT / "AGENTS.md"
URL = re.compile(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+")
TARGET_LIMIT_GIB = 40


def command(args, *, input=None):
    result = subprocess.run(args, input=input, text=True, capture_output=True, check=False)
    if result.returncode:
        raise RuntimeError(f"{' '.join(args[:3])} failed: {result.stderr.strip()}")
    return result.stdout


def records(output):
    """Parse JSON lines, skipping a torn last line still being written by a live run."""
    values = []
    for line in output.splitlines():
        if not line.strip():
            continue
        try:
            values.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return values


def one(output):
    values = records(output)
    if len(values) != 1:
        raise RuntimeError("expected one JSON record")
    return values[0]


def load_file():
    if not CONFIG.exists():
        raise RuntimeError(f"create {CONFIG} from fleet.example.toml")
    if CONFIG.stat().st_mode & 0o077:
        raise RuntimeError(f"{CONFIG} must have owner-only permissions (chmod 600)")
    return tomllib.loads(CONFIG.read_text())


def load():
    data = load_file()
    for key in ("github_token", "repo"):
        if not data.get(key):
            raise RuntimeError(f"{CONFIG}: missing {key}")
    # An empty or absent remote means the local API configuration, which is
    # how the driver runs on a swarm's own control node without a tunnel.
    data.setdefault("remote", "")
    data.setdefault("workers", 4)
    return data


def load_reporting(remote):
    """Settings for the read-only report and benchmark actions.

    Reporting reads only session metrics and never touches GitHub, so it
    needs no token: a missing config file means the local API with default
    state, and --remote overrides the file when both are present.
    """
    data = load_file() if CONFIG.exists() else {}
    data.setdefault("remote", "")
    data.setdefault("workers", 4)
    if remote is not None:
        data["remote"] = "" if remote == "local" else remote
    return data


def state_path(config):
    return Path(config.get("state_dir", ROOT / ".dev" / "fleet"))


def save(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as file:
        json.dump(value, file)
        file.write("\n")


def task_suffix(task_id):
    """The last six characters of a tasky id, the random part, lowercased.

    A full 26-character ULID and its six-character suffix name the same task."""
    suffix = task_id.rsplit("-", 1)[-1].lower()
    if not re.fullmatch(r"[a-z0-9]+", suffix):
        raise RuntimeError("task id must end in an alphanumeric suffix")
    return suffix[-6:]


def task_fields(task):
    task = task.get("task", task)
    return (task.get("title") or "", task.get("body") or task.get("description") or "",
            task.get("test_plan") or task.get("testPlan") or "")


def prompt(task_id, task, config, branch):
    title, body, tests = task_fields(task)
    return f"""You are a long-lived swarmy development worker. Your computer persists between tasks, so keep it tidy: every task gets a fresh clone in its own directory, one new branch from master, and you leave nothing uncommitted behind.

Before starting this task:
1. mkdir -p ~/work. For every other directory under ~/work: if it is a git clone whose branch has been pushed and `git status --porcelain` is empty, remove it; otherwise leave it in place and mention it in your final message. Never delete unpushed work.
2. If `du -sb ~/.cargo-target` reports more than {TARGET_LIMIT_GIB} GiB, run `cargo clean` from any clone (the shared target directory lives outside the clones).
3. Clone https://github.com/{config['repo']}.git into ~/work/{branch.split('/')[-1]}, and create branch {branch} from origin/master. Never reuse or force-push a branch.
   Commit and push work in progress to {branch} at least once an hour and before any command expected to run longer than ten minutes (builds, test suites); a pushed branch with a work-in-progress commit is fine, an unpushed hour of work is not, because a session can end without warning.
   If a push is ever rejected because the token lacks the `workflow` scope (a change under .github/workflows), keep that change in a separate commit, move it out of the branch, save it as `ci/pending/{branch.split('/')[-1]}.patch` in the repository, commit and push that instead, and say in the pull request that the workflow change is pending an operator push.

You are executing tasky {task_id}: {title}.

Repository contract (AGENTS.md):
{AGENTS.read_text()}

Task body:
{body}

Test plan:
{tests}

Read the repository's AGENTS.md and docs/DESIGN.md before changing files. Implement only this task. Run cargo fmt --all --check, cargo test --workspace --locked with the dev stack from scripts/dev-stack.sh start and .dev/env sourced, and cargo clippy --workspace --all-targets --locked -- -D warnings. Work through the test plan, including the root-only suites AGENTS.md maps to the areas you changed. Commit with an imperative subject and a body explaining why. Push {branch} to origin. Open one pull request against master with a title containing tasky {task_id}. Its description must say what was built, list exact validation commands and results, and list test plan items not verified and why. Do not include credentials in logs, commits, or the PR. When you are done, stop the dev stack with scripts/dev-stack.sh stop, and finish by reporting the pull request URL in your last message.
"""


def swarmy(config, *args):
    remote = config.get("remote")
    return ["swarmy", *(["--remote", remote] if remote else []), *args]


def tasky(*args, json_output=False):
    return ["tasky", *(["--json"] if json_output else []), "task", *args]


def workers_path(config):
    return state_path(config) / "workers.json"


def load_workers(config):
    path = workers_path(config)
    return json.loads(path.read_text()) if path.exists() else {}


def save_workers(config, workers):
    save(workers_path(config), workers)


def selection_args(args, config):
    provider = getattr(args, "provider", None) or config.get("provider")
    model = getattr(args, "model", None) or config.get("model")
    effort = getattr(args, "effort", None) or config.get("effort")
    if not provider or not model:
        raise RuntimeError("provider and model must be supplied or configured")
    selection = ["--provider", provider, "--model", model]
    if effort:
        selection += ["--effort", effort]
    return provider, model, effort, selection


def create_worker(name, config, selection, image):
    extra = ["--image", image] if image else []
    # A worker builds the workspace; the sandbox default of 768 MiB would be
    # enforced as a cgroup limit and kill cargo.
    extra += ["--memory", str(config.get("memory_mib", 6144))]
    command(swarmy(config, "agent", "create", name, *extra, "--description", "fleet worker",
                   *selection, "--github-token-stdin"), input=config["github_token"] + "\n")


def worker_meta_path(config, name):
    return state_path(config) / (name + ".meta.json")


def worker_meta(config, name):
    path = worker_meta_path(config, name)
    return json.loads(path.read_text()) if path.exists() else {}


def pick_worker(config, selection, image, provider, model):
    """Prefer an idle worker created with the requested provider and model.

    A worker's selection is fixed when it is created (run --agent takes no
    overrides), so a task that asks for ChatGPT must not land on an
    OpenRouter worker. Any idle worker is used only when none matches and
    the pool is full."""
    workers = load_workers(config)
    idle = [name for name, assigned in sorted(workers.items()) if assigned is None]
    for name in idle:
        meta = worker_meta(config, name)
        if meta.get("provider") == provider and meta.get("model") == model:
            return name, workers
    if len(workers) < int(config["workers"]):
        # The first free number, so a reset worker's name is reused rather
        # than colliding with a live one when the pool has gaps.
        name = next(f"worker-{n}" for n in range(1, int(config["workers"]) + 1) if f"worker-{n}" not in workers)
        create_worker(name, config, selection, image)
        workers[name] = None
        save_workers(config, workers)
        save(worker_meta_path(config, name), {"provider": provider, "model": model, "image": image})
        return name, workers
    if idle:
        name = idle[0]
        meta = worker_meta(config, name)
        print(f"note: {name} runs {meta.get('provider') or '?'}/{meta.get('model') or '?'}, not the requested "
              f"{provider}/{model}; pool is full", file=sys.stderr)
        return name, workers
    raise RuntimeError(f"all {len(workers)} workers are busy; release a task or raise workers in {CONFIG}")


def launch(args, config):
    suffix = task_suffix(args.task_id)
    branch = "swarmy/" + suffix
    path = state_path(config) / (suffix + ".json")
    if path.exists():
        raise RuntimeError(f"{args.task_id} already launched")
    task = one(command(tasky("show", args.task_id, json_output=True)))
    status = task.get("status")
    if status == "todo":
        # Refuse a task whose dependencies are unfinished before a worker is spent.
        command(tasky("start", args.task_id))
    elif status != "in_progress":
        raise RuntimeError(f"tasky task {args.task_id} is {status}; only todo or in-progress tasks launch")
    provider, model, effort, selection = selection_args(args, config)
    image = args.image or config.get("image")
    if image and ":" not in image:
        raise RuntimeError("image must be NAME:TAG, for example swarmy-dev:dev")
    if getattr(args, "worker", None):
        # A task that must run on a particular worker, for example to pick up
        # files an earlier session left on that worker's disk.
        workers = load_workers(config)
        if args.worker not in workers:
            raise RuntimeError(f"unknown worker {args.worker}")
        if workers[args.worker]:
            raise RuntimeError(f"{args.worker} still holds {workers[args.worker]}; release it first")
        worker = args.worker
    else:
        worker, workers = pick_worker(config, selection, image, provider, model)
    log = state_path(config) / (suffix + ".jsonl")
    log.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with log.open("w") as stream:
        os.chmod(log, 0o600)
        # run --agent takes the agent's own provider, model, and effort and
        # rejects overrides, so selection only applies at worker creation.
        # Each task runs in a fresh side conversation on the worker: same disk
        # and memory files, empty context, so a metered provider is not billed
        # for every earlier task on every turn.
        process = subprocess.Popen(swarmy(config, "run", "--agent", worker, "--new",
                                          "--json", prompt(args.task_id, task, config, branch)),
                                   stdout=stream, stderr=subprocess.DEVNULL,
                                   start_new_session=True)
    session = None
    for _ in range(100):
        if log.exists():
            for event in records(log.read_text()):
                if event.get("event") in ("session_created", "session_opened"):
                    session = event.get("session_id")
                    break
        if session or process.poll() is not None:
            break
        time.sleep(0.1)
    if not session:
        raise RuntimeError(f"run did not report a session id; inspect {log}")
    workers[worker] = args.task_id
    save_workers(config, workers)
    save(path, {"task_id": args.task_id, "worker": worker, "branch": branch,
                "session_id": session, "provider": provider, "model": model,
                "effort": effort, "started_at": datetime.now(timezone.utc).isoformat()})
    print(f"launched {args.task_id} on {worker} session={session}")


def assignment(config, task_id):
    suffix = task_suffix(task_id)
    path = state_path(config) / (suffix + ".json")
    if not path.exists():
        raise RuntimeError(f"no fleet launch for {task_id}")
    return path, json.loads(path.read_text())


def launch_log_path(config, task_id):
    return state_path(config) / (task_suffix(task_id) + ".jsonl")


def session_id_from_log(path):
    """The session id from a launch log's first session event, if present.

    The release action deletes the assignment JSON, but the append-only
    launch log outlives it, so a finished task still resolves through this.
    """
    try:
        text = path.read_text()
    except OSError:
        return None
    for event in records(text):
        if not isinstance(event, dict):
            continue
        if event.get("event") in ("session_created", "session_opened"):
            session_id = event.get("session_id")
            if isinstance(session_id, str) and session_id:
                return session_id
    return None


def log_event_time(path, events):
    """When a launch log started: the first event's timestamp, else mtime.

    The launch announcement carries no timestamp today, so file modification
    time is the fallback; a future timestamp field on that event takes
    precedence when it parses.
    """
    first = next((event for event in events if isinstance(event, dict)), None)
    if first is not None:
        for key in ("timestamp", "started_at", "created_at", "time", "launched_at"):
            value = first.get(key)
            if isinstance(value, str) and value.strip():
                try:
                    return parse_report_time(value)
                except RuntimeError:
                    continue
        for key, scale in (("unix_ns", 1_000_000_000.0), ("unix_ms", 1_000.0),
                           ("unix_s", 1.0), ("timestamp", 1.0)):
            value = first.get(key)
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                continue
            if not math.isfinite(value) or value <= 0:
                continue
            return datetime.fromtimestamp(value / scale, tz=timezone.utc)
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    except OSError:
        return None


def resolve_report_session(config, task_id):
    """A task's session id for the report, including released tasks.

    The assignment JSON is authoritative while the task is active; after
    release only the launch log remains, so fall back to its session event.
    """
    suffix = task_suffix(task_id)
    path = state_path(config) / (suffix + ".json")
    if path.exists():
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            pass
        else:
            if isinstance(data, dict) and data.get("session_id"):
                return str(data["session_id"])
    session_id = session_id_from_log(launch_log_path(config, task_id))
    if session_id is not None:
        return session_id
    raise RuntimeError(f"no fleet launch for {task_id}")


def session_events(config, session_id):
    return records(command(swarmy(config, "session", "show", session_id, "--json")))


def current_session(config, session_id, sessions=None):
    """Follow summarization links to the newest successor session.

    Side sessions archive into a successor with the summary plus the last
    few turns; the driver polls the task session, so status and collect
    must resolve that chain or they report a completed session forever.
    """
    if not session_id:
        return session_id
    if sessions is None:
        try:
            sessions = {item["session_id"]: item
                        for item in records(command(swarmy(config, "session", "ls", "--json")))
                        if "session_id" in item}
        except RuntimeError:
            return session_id
    seen = set()
    current = session_id
    while current not in seen:
        seen.add(current)
        item = sessions.get(current)
        nxt = item.get("next_session") if isinstance(item, dict) else None
        if isinstance(nxt, str) and nxt and nxt not in seen:
            current = nxt
        else:
            break
    return current


def has_pressure(events):
    """Whether the session log carries a context_pressure warning."""
    for event in events:
        if not isinstance(event, dict):
            continue
        try:
            text = json.dumps(event)
        except (TypeError, ValueError):
            continue
        if "context_pressure" in text:
            return True
    return False


def state_for(session, events, log):
    state = session.get("state") if session else None
    wait = next((item for item in events if item.get("state") == "waiting_for_inference"), None)
    if state == "sleeping" and wait:
        state = "waiting_inference"
    if state is None:
        return "unknown", ""
    outcomes = [item for item in log if item.get("event") == "run_outcome"]
    if state in ("idle", "completed"):
        # A recorded failure only describes the last turn while the session
        # stays idle; a later resume makes the live state authoritative.
        if outcomes and outcomes[-1].get("outcome") == "failed":
            return "failed", ""
        return "idle", ""
    reasons = "; ".join(wait.get("reasons", [])) if wait and state == "waiting_inference" else ""
    return state, ("waiting for inference: " + reasons if reasons else "")


def state_age(session):
    # Events in the session log have sequence numbers but no timestamps. The
    # session listing exposes the time of the last durable state transition.
    since = session.get("state_since") if session else None
    if not since:
        return None
    seconds = (datetime.now(timezone.utc) - datetime.fromisoformat(since.replace("Z", "+00:00"))).total_seconds()
    return max(0, int(seconds))


def age_label(seconds):
    if seconds is None:
        return "?"
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h{(seconds % 3600) // 60}m"


def status(config):
    workers = load_workers(config)
    # session ls carries the state and transition time; session show supplies
    # optional wait reasons and the assistant messages used by collect.
    sessions = {item["session_id"]: item
                for item in records(command(swarmy(config, "session", "ls", "--json")))
                if "session_id" in item and "state" in item}
    threshold = float(config.get("stall_minutes", 10)) * 60
    if not math.isfinite(threshold) or threshold <= 0:
        raise ValueError("stall_minutes must be positive")
    stalled = False
    for name, task_id in sorted(workers.items()):
        detail = one(command(swarmy(config, "agent", "show", name, "--json")))
        data = {}
        logged = []
        if task_id:
            suffix = task_suffix(task_id)
            assignment_path = state_path(config) / (suffix + ".json")
            data = json.loads(assignment_path.read_text()) if assignment_path.exists() else {}
            run_log = state_path(config) / (suffix + ".jsonl")
            logged = records(run_log.read_text()) if run_log.exists() else []
        # A task runs in its own side conversation; fall back to the main one
        # for launches recorded before that change.
        session_id = data.get("session_id") or detail.get("main_session")
        session_id = current_session(config, session_id, sessions)
        events = session_events(config, session_id) if session_id else []
        session = sessions.get(session_id)
        state, reasons = state_for(session, events, logged) if task_id else ("idle", "")
        age = state_age(session)
        if task_id and state in ("waiting_inference", "leased") and age is not None and age > threshold:
            state_label = f"STALLED {state} {age_label(age)}"
            stalled = True
        else:
            state_label = f"{state} {age_label(age)}"
        if reasons:
            state_label += "; " + reasons
        if task_id and session_id and has_pressure(events):
            state_label += "; context_pressure"
        started = data.get("started_at")
        elapsed = int((datetime.now(timezone.utc) - datetime.fromisoformat(started.replace("Z", "+00:00"))).total_seconds()) if started else 0
        print(f"{name}\t{task_id or '-'}\t{detail.get('provider') or '-'}\t{detail.get('model') or '-'}\t"
              f"{state_label}\t{elapsed}s\t${detail.get('cost_dollars', 0)}")
    return 2 if stalled else 0


def last_message(events):
    messages = []
    for event in events:
        payload = event.get("message_appended") or event.get("inference_completed") or {}
        message = payload.get("message", {})
        if message.get("role") == "assistant":
            content = "".join(part.get("text", {}).get("text", "") for part in message.get("parts", []))
            if content:
                messages.append(content)
    return messages[-1] if messages else ""


def verify_pr(url, data, config, *, merged=False):
    parsed = urlparse(url)
    if parsed.hostname != "github.com" or parsed.path.split("/")[1:3] != config["repo"].split("/"):
        raise RuntimeError("PR URL is outside the configured repository")
    pr = one(command(["gh", "pr", "view", url, "--repo", config["repo"],
                      "--json", "url,state,baseRefName,headRefName"]))
    required_state = "MERGED" if merged else "OPEN"
    if (pr.get("state") != required_state or pr.get("baseRefName") != "master" or
            pr.get("headRefName") != data["branch"] or pr.get("url") != url):
        raise RuntimeError(f"PR is not {required_state.lower()} against master from {data['branch']}")


def collect(task_id, config):
    path, data = assignment(config, task_id)
    agent = one(command(swarmy(config, "agent", "show", data["worker"], "--json")))
    session_id = current_session(config, data["session_id"])
    message = last_message(session_events(config, session_id))
    match = URL.search(message)
    if match:
        url = match.group(0)
        source = "last_message"
        merged = False
    else:
        pull_requests = json.loads(command(["gh", "pr", "list", "--repo", config["repo"],
                                            "--head", data["branch"], "--state", "all",
                                            "--json", "url,state"]))
        eligible = [pr for pr in pull_requests if pr.get("state") in ("OPEN", "MERGED")]
        if len(eligible) != 1:
            raise RuntimeError(f"expected exactly one open or merged pull request for {data['branch']}; found {len(eligible)}")
        url = eligible[0]["url"]
        source = "branch_lookup"
        merged = eligible[0]["state"] == "MERGED"
    verify_pr(url, data, config, merged=merged)
    command(tasky("pr", task_id, url))
    command(tasky("test", task_id))
    data["pr_url"] = url
    data["pr_source"] = source
    save(path, data)
    print(url)


def resume(task_id, message, config):
    _, data = assignment(config, task_id)
    # A follow-up on the task's own conversation continues it. Resolve the
    # newest successor first; run --session also follows, so this is a belt
    # and braces against an archived id.
    session_id = current_session(config, data["session_id"])
    args = swarmy(config, "run", "--session", session_id, "--json", message)
    result = subprocess.run(args, text=True, capture_output=True, check=False)
    with (state_path(config) / (task_suffix(task_id) + ".jsonl")).open("a") as log:
        log.write(result.stdout)
    if result.returncode:
        raise RuntimeError(f"follow-up failed: {result.stderr.strip()}")
    outcomes = [item for item in records(result.stdout) if item.get("event") == "run_outcome"]
    if outcomes and outcomes[-1].get("outcome") == "failed":
        raise RuntimeError(outcomes[-1].get("reason", "turn failed"))
    print(f"resumed {task_id}")


def release(task_id, config, *, force=False):
    path, data = assignment(config, task_id)
    if not force:
        if not data.get("pr_url"):
            raise RuntimeError("collect the pull request before releasing the worker, or pass --force")
        verify_pr(data["pr_url"], data, config, merged=True)
    workers = load_workers(config)
    held = workers.get(data["worker"])
    if held and task_suffix(held) == task_suffix(task_id):
        workers[data["worker"]] = None
        save_workers(config, workers)
    path.unlink()
    print(f"released {data['worker']} from {task_id}")


def kill(task_id, config, timeout_seconds):
    _, data = assignment(config, task_id)
    agent = one(command(swarmy(config, "agent", "show", data["worker"], "--json")))
    session_id = current_session(config, data["session_id"])
    command(swarmy(config, "session", "interrupt", session_id))
    deadline = time.monotonic() + timeout_seconds
    while True:
        sessions = records(command(swarmy(config, "session", "ls", "--json")))
        by_id = {item.get("session_id"): item for item in sessions if item.get("session_id")}
        live = current_session(config, session_id, by_id)
        # An archived id during the wait means summarization moved the task;
        # keep waiting on the successor and interrupt it once.
        if live != session_id:
            session_id = live
            try:
                command(swarmy(config, "session", "interrupt", session_id))
            except RuntimeError:
                pass
        session = next((item for item in sessions if item.get("session_id") == session_id and "state" in item), None)
        if session and session["state"] == "idle":
            break
        if time.monotonic() >= deadline:
            raise RuntimeError(f"session {session_id} did not reach Idle within {timeout_seconds} seconds; worker remains assigned")
        time.sleep(0.1)
    release(task_id, config, force=True)
    print(f"tasky task {task_id} is still in progress; the operator can relaunch or cancel it")


def reset(worker, config):
    workers = load_workers(config)
    if worker not in workers:
        raise RuntimeError(f"unknown worker {worker}")
    if workers[worker]:
        raise RuntimeError(f"{worker} still holds {workers[worker]}; release it first")
    command(swarmy(config, "agent", "delete", worker, "--yes"))
    del workers[worker]
    save_workers(config, workers)
    worker_meta_path(config, worker).unlink(missing_ok=True)
    print(f"deleted {worker}; the next launch recreates it from the image")


def percentile(samples, percent):
    """Nearest-rank percentile matching the store rollup: sort ascending and
    take index len * p // 100, capped at the last sample. Empty input is None."""
    values = sorted(value for value in samples if isinstance(value, (int, float)) and math.isfinite(value))
    if not values:
        return None
    return values[min(len(values) * int(percent) // 100, len(values) - 1)]


def mean(values):
    finite = [value for value in values if isinstance(value, (int, float)) and math.isfinite(value)]
    if not finite:
        return None
    return sum(finite) / len(finite)


def parse_report_time(value):
    """Parse an ISO 8601 time; a missing offset means UTC."""
    if not value or not str(value).strip():
        raise RuntimeError("report --since requires a time value")
    text = str(value).strip().replace("Z", "+00:00")
    try:
        moment = datetime.fromisoformat(text)
    except ValueError:
        raise RuntimeError(f"report --since cannot parse {value!r}; use ISO 8601") from None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    return moment


def parse_report_argv(tokens):
    """Split report tokens into groups so repeated --label keeps its members.

    Everything after `--label NAME` belongs to that label until the next
    --label. argparse cannot preserve that grouping, so the report entry
    point re-scans the raw tokens instead of using the parsed namespace.
    --remote and --wall come from the parsed namespace instead; the scan
    only skips over them and their values.
    """
    as_json = False
    since = None
    groups = []
    current = None

    def group():
        nonlocal current
        if current is None:
            current = {"label": None, "tasks": [], "sessions": []}
            groups.append(current)
        return current

    index = 0
    while index < len(tokens):
        token = tokens[index]
        if token == "--json":
            as_json = True
            index += 1
        elif token == "--since":
            if index + 1 >= len(tokens):
                raise RuntimeError("report --since requires a time value")
            since = tokens[index + 1]
            index += 2
        elif token == "--remote":
            if index + 1 >= len(tokens):
                raise RuntimeError("report --remote requires a remote name")
            index += 2
        elif token == "--wall":
            if index + 1 >= len(tokens):
                raise RuntimeError("report --wall requires SESSION=SECONDS")
            index += 2
        elif token == "--label":
            if index + 1 >= len(tokens):
                raise RuntimeError("report --label requires a name")
            current = {"label": tokens[index + 1], "tasks": [], "sessions": []}
            groups.append(current)
            index += 2
        elif token == "--session":
            if index + 1 >= len(tokens):
                raise RuntimeError("report --session requires a session id")
            group()["sessions"].append(tokens[index + 1])
            index += 2
        elif token.startswith("--"):
            raise RuntimeError(f"report: unknown flag {token}")
        else:
            group()["tasks"].append(token)
            index += 1
    return as_json, since, groups


def parse_wall_args(values):
    """Wall-clock seconds per session from repeated --wall SESSION=SECONDS."""
    walls = {}
    for item in values or []:
        session, sep, seconds = item.partition("=")
        try:
            wall = float(seconds)
        except ValueError:
            raise RuntimeError(f"report --wall must look like SESSION=SECONDS, got {item!r}") from None
        if not session or not sep or not math.isfinite(wall) or wall < 0:
            raise RuntimeError(f"report --wall needs a session id and non-negative seconds, got {item!r}")
        walls[session] = wall
    return walls


def tasks_since(config, since):
    """Every launched task whose assignment started at or after the time.

    Assignments carry started_at while active; released tasks keep only
    their launch log, whose first event time (or file modification time)
    stands in for the launch time.
    """
    moment = parse_report_time(since)
    base = state_path(config)
    found = []
    seen = set()
    if not base.exists():
        return found
    for path in sorted(base.glob("*.json")):
        if path.name == "workers.json":
            continue
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict) or "task_id" not in data or "session_id" not in data:
            continue
        seen.add(path.stem)
        try:
            started = parse_report_time(data.get("started_at")) if data.get("started_at") else None
        except RuntimeError:
            continue
        if started is not None and started >= moment:
            found.append((str(data["task_id"]), str(data["session_id"])))
    for path in sorted(base.glob("*.jsonl")):
        if path.stem in seen:
            continue
        try:
            events = records(path.read_text())
        except OSError:
            continue
        session_id = session_id_from_log(path)
        if session_id is None:
            continue
        started = log_event_time(path, events)
        if started is not None and started >= moment:
            found.append((path.stem, session_id))
    return found


def fetch_turn_metrics(config, session_id):
    """Read one session's durable per-turn records through the CLI."""
    output = command(swarmy(config, "session", "metrics", session_id, "--json"))
    text = output.strip()
    if not text:
        return []
    try:
        value = json.loads(text)
        if isinstance(value, list):
            return [item for item in value if isinstance(item, dict)]
        if isinstance(value, dict):
            return [value]
    except json.JSONDecodeError:
        pass
    turns = []
    for line in text.splitlines():
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, list):
            turns.extend(item for item in value if isinstance(item, dict))
        elif isinstance(value, dict):
            turns.append(value)
    return turns


def turn_duration_s(turn):
    """One turn's wall time: its append-to-idle latency, or its stage span."""
    idle = turn.get("append_to_idle_ms")
    if isinstance(idle, (int, float)) and math.isfinite(idle) and idle >= 0:
        return float(idle) / 1000.0
    stamps = [stage.get("unix_ns") for stage in turn.get("stages", [])
              if isinstance(stage, dict) and isinstance(stage.get("unix_ns"), int)]
    if len(stamps) >= 2:
        span = max(stamps) - min(stamps)
        if span >= 0:
            return span / 1_000_000_000.0
    return 0.0


def summarize_turns(name, session_id, turns, wall_s=None):
    """Aggregate raw per-turn records into one comparable row.

    Latency percentiles pool every observed turn; counts and token totals
    sum; waits pool rate-limit, gateway, and provider-failure waits while
    retries and errors keep their own totals. wall_s is the runner-measured
    wall time of the whole run, which stays comparable even when the durable
    per-turn metrics are incomplete.
    """
    first_token, inference, rates, tools, placements = [], [], [], [], []
    duration = 0.0
    waits = retries = errors = single_chunk = 0
    input_tokens = cached_tokens = output_tokens = reasoning_tokens = 0
    cost_micros = chunks = 0
    bytes_fetched = 0
    cold = warm = 0
    for turn in turns:
        duration += turn_duration_s(turn)
        for key, bucket in (("append_to_first_token_ms", first_token),
                            ("inference_duration_ms", inference)):
            value = turn.get(key)
            if isinstance(value, (int, float)) and math.isfinite(value):
                bucket.append(float(value))
        if turn.get("error"):
            errors += 1
        for request in turn.get("inference", []) if isinstance(turn.get("inference"), list) else []:
            if not isinstance(request, dict):
                continue
            for key in ("input_tokens", "cached_input_tokens", "output_tokens",
                        "reasoning_tokens", "cost_micros"):
                value = request.get(key)
                if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                    continue
                if key == "input_tokens":
                    input_tokens += value
                elif key == "cached_input_tokens":
                    cached_tokens += value
                elif key == "output_tokens":
                    output_tokens += value
                elif key == "reasoning_tokens":
                    reasoning_tokens += value
                else:
                    cost_micros += value
            rate = request.get("output_tokens_per_second")
            if isinstance(rate, (int, float)) and math.isfinite(rate):
                rates.append(float(rate))
            # Throughput now covers the whole request; a response delivered
            # in one chunk carries streamed=false so the table can label it.
            if request.get("streamed") is False:
                single_chunk += 1
            retries += int(request.get("retries") or 0)
            waits += int(request.get("rate_limit_waits") or 0)
            waits += int(request.get("gateway_waits") or 0)
            waits += int(request.get("provider_failures") or 0)
            if request.get("error"):
                errors += 1
        for tool in turn.get("tools", []) if isinstance(turn.get("tools"), list) else []:
            if not isinstance(tool, dict):
                continue
            start, end = tool.get("dispatched_ns"), tool.get("completed_ns")
            if isinstance(start, int) and isinstance(end, int) and end >= start:
                tools.append((end - start) / 1_000_000.0)
        computer = turn.get("computer")
        if isinstance(computer, dict):
            placement = computer.get("placement_ms")
            if isinstance(placement, (int, float)) and math.isfinite(placement):
                placements.append(float(placement))
            if computer.get("cold") is True:
                cold += 1
            else:
                warm += 1
            fetched = computer.get("chunks_fetched")
            if isinstance(fetched, int) and fetched > 0:
                chunks += fetched
            fetched_bytes = computer.get("bytes_fetched")
            if isinstance(fetched_bytes, int) and fetched_bytes > 0:
                bytes_fetched += fetched_bytes
    return {
        "task": name,
        "session_id": session_id,
        "turns": len(turns),
        "duration_s": duration,
        "wall_s": wall_s,
        "a2f_p50_ms": percentile(first_token, 50),
        "a2f_p95_ms": percentile(first_token, 95),
        "infer_p50_ms": percentile(inference, 50),
        "infer_p95_ms": percentile(inference, 95),
        "tps_mean": mean(rates),
        "tps_p95": percentile(rates, 95),
        "tool_calls": len(tools),
        "single_chunk": single_chunk,
        "tool_p50_ms": percentile(tools, 50),
        "tool_p95_ms": percentile(tools, 95),
        "place_cold": cold,
        "place_warm": warm,
        "place_p50_ms": percentile(placements, 50),
        "chunks_fetched": chunks,
        "bytes_fetched": bytes_fetched,
        "waits": waits,
        "retries": retries,
        "errors": errors,
        "input_tokens": input_tokens,
        "cached_input_tokens": cached_tokens,
        "output_tokens": output_tokens,
        "reasoning_tokens": reasoning_tokens,
        "cost_dollars": cost_micros / 1_000_000.0,
    }


MEDIAN_KEYS = ("turns", "duration_s", "wall_s", "a2f_p50_ms", "a2f_p95_ms", "infer_p50_ms",
               "infer_p95_ms", "tps_mean", "tps_p95", "single_chunk", "tool_calls", "tool_p50_ms",
               "tool_p95_ms", "place_cold", "place_warm", "place_p50_ms",
               "chunks_fetched", "bytes_fetched", "waits", "retries", "errors",
               "input_tokens", "cached_input_tokens", "output_tokens",
               "reasoning_tokens", "cost_dollars")


def median_row(label, rows):
    """The per-label median: the p50 across that label's per-task values."""
    medians = {"label": label, "tasks": len(rows)}
    for key in MEDIAN_KEYS:
        medians[key] = percentile([row[key] for row in rows
                                   if isinstance(row.get(key), (int, float))
                                   and math.isfinite(row[key])], 50)
    return medians


REPORT_COLUMNS = ("task", "turns", "duration_s", "wall_s", "a2f_p50_ms", "a2f_p95_ms",
                  "infer_p50_ms", "infer_p95_ms", "tps_mean", "tps_p95",
                  "single_chunk", "tool_calls", "tool_p50_ms", "tool_p95_ms", "place_cold",
                  "place_warm", "place_p50_ms", "chunks_fetched", "bytes_fetched",
                  "waits", "retries", "errors",
                  "input_tokens", "cached_input_tokens", "output_tokens",
                  "reasoning_tokens", "cost_dollars")


def format_cell(key, value):
    if value is None:
        return "-"
    if key in ("turns", "tool_calls", "single_chunk", "place_cold", "place_warm", "waits",
               "retries", "errors", "input_tokens", "cached_input_tokens",
               "output_tokens", "reasoning_tokens", "chunks_fetched", "bytes_fetched"):
        return str(int(value))
    if key == "cost_dollars":
        return f"{value:.4f}"
    if isinstance(value, float):
        return f"{value:.1f}"
    return str(value)


def markdown_table(rows, total):
    header = "| " + " | ".join(REPORT_COLUMNS) + " |"
    divider = "| " + " | ".join("---" for _ in REPORT_COLUMNS) + " |"
    lines = [header, divider]
    for row in rows:
        lines.append("| " + " | ".join(format_cell(key, row.get(key)) for key in REPORT_COLUMNS) + " |")
    lines.append("| " + " | ".join(
        format_cell(key, total.get(key)) if key != "task" else "total"
        for key in REPORT_COLUMNS) + " |")
    return "\n".join(lines)


def report_command(tokens, config, walls=None):
    """Aggregate per-turn metrics for tasks or sessions into a table.

    Each entry resolves to a session id (task ids through their fleet
    assignment or, after release, their launch log, --session ids
    directly, --since through assignment start times and launch log
    times), its records load through `swarmy session metrics --json`, and
    the per-task rows pool into a totals row. Repeated --label prints one
    table per label plus a final table of the per-label medians. walls maps
    session ids to runner-measured wall seconds (--wall SESSION=SECONDS);
    each row prints its wall as wall_s next to duration_s, and the totals
    row sums the known walls.
    """
    as_json, since, groups = parse_report_argv(tokens)
    walls = walls or {}
    if since is not None and not groups:
        groups.append({"label": None, "tasks": [], "sessions": []})
    if not groups:
        raise RuntimeError("report requires task ids, --session ids, or --since TIME")
    labeled = any(group["label"] for group in groups)
    tables = []
    for group in groups:
        entries = [(task, None) for task in group["tasks"]]
        entries += [(session, session) for session in group["sessions"]]
        if since is not None and not entries:
            entries = tasks_since(config, since)
            if not entries:
                raise RuntimeError(f"no tasks launched since {since}")
        if not entries:
            raise RuntimeError("report requires task ids, --session ids, or --since TIME")
        rows, pooled, session_ids = [], [], None
        resolved = []
        for display, direct in entries:
            if direct is None:
                session_id = resolve_report_session(config, display)
            else:
                session_id = direct
            resolved.append(session_id)
            turns = fetch_turn_metrics(config, session_id)
            rows.append(summarize_turns(display, session_id, turns, walls.get(session_id)))
            pooled.extend(turns)
            session_ids = session_id if len(entries) == 1 else None
        total = summarize_turns("total", session_ids or "", pooled)
        present = [walls[session_id] for session_id in resolved if session_id in walls]
        total["wall_s"] = sum(present) if present else None
        tables.append({"label": group["label"], "rows": rows, "total": total})
    if as_json:
        if labeled:
            print(json.dumps({"labels": tables,
                              "medians": [median_row(table["label"], table["rows"])
                                          for table in tables]}, indent=2))
        else:
            print(json.dumps({"rows": tables[0]["rows"], "total": tables[0]["total"]}, indent=2))
        return 0
    parts = []
    for table in tables:
        if table["label"]:
            parts.append(f"## {table['label']}")
        parts.append(markdown_table(table["rows"], table["total"]))
    if labeled:
        medians = [median_row(table["label"], table["rows"]) for table in tables]
        parts.append("## medians")
        header = "| label | " + " | ".join(key for key in MEDIAN_KEYS) + " |"
        divider = "| --- | " + " | ".join("---" for _ in MEDIAN_KEYS) + " |"
        lines = [header, divider]
        for row in medians:
            lines.append("| " + str(row["label"]) + " | " +
                         " | ".join(format_cell(key, row.get(key)) for key in MEDIAN_KEYS) + " |")
        parts.append("\n".join(lines))
    print("\n\n".join(parts))
    return 0


def benchmark(args):
    """Run one isolated benchmark session without tasky or a persistent worker."""
    if not args.prompt_file.is_file():
        raise RuntimeError(f"missing benchmark prompt: {args.prompt_file}")
    # An empty or "local" remote uses the node's own API configuration, the
    # same rule as the fleet.toml remote, so the benchmark runs on a control
    # node without a tunnel.
    remote = [] if args.remote in ("", "local") else ["--remote", args.remote]
    image = ["--image", args.image] if args.image else []
    cmd = ["swarmy", *remote, "run", "--json", *image,
           "--provider", args.provider, "--model", args.model,
           "--effort", args.effort, args.prompt_file.read_text()]
    result = subprocess.run(cmd, text=True, stdout=sys.stdout, stderr=sys.stderr, check=False)
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    launch_parser = sub.add_parser("launch", help="run a tasky task on an idle worker, creating one if the pool has room")
    launch_parser.add_argument("task_id")
    launch_parser.add_argument("--provider")
    launch_parser.add_argument("--model")
    launch_parser.add_argument("--effort")
    launch_parser.add_argument("--image", help="registered image as NAME:TAG for a newly created worker; default is the remote's default image")
    launch_parser.add_argument("--worker", help="run on this idle worker instead of the first free one, for example to reuse files on its disk")
    sub.add_parser("status", help="one line per worker: task, provider, model, state age, elapsed, cost; exits 2 on a stall")
    sub.add_parser("collect", help="record the worker's pull request in tasky").add_argument("task_id")
    resume_parser = sub.add_parser("resume", help="send a follow-up message to the worker on this task")
    resume_parser.add_argument("task_id")
    resume_parser.add_argument("message")
    release_parser = sub.add_parser("release", aliases=["rm"], help="free the worker once the task's pull request is merged")
    release_parser.add_argument("task_id")
    release_parser.add_argument("--force", action="store_true", help="free the worker even without a merged pull request")
    kill_parser = sub.add_parser("kill", help="interrupt a task and free its worker after the session reaches Idle")
    kill_parser.add_argument("task_id")
    kill_parser.add_argument("--timeout-seconds", type=float, help="seconds to wait for Idle (default: config kill_timeout_seconds or 60)")
    sub.add_parser("reset", help="delete an idle worker and its disk; the next launch recreates it").add_argument("worker")
    bench = sub.add_parser("benchmark", help="run one isolated benchmark prompt on a remote (use --remote local on a control node)")
    bench.add_argument("--remote", default="local")
    bench.add_argument("--provider", required=True)
    bench.add_argument("--model", required=True)
    bench.add_argument("--effort", required=True)
    bench.add_argument("--prompt-file", required=True, type=Path)
    bench.add_argument("--image", help="registered image as NAME:TAG for the isolated session; default is the remote's default image")
    report_parser = sub.add_parser("report", help="aggregate per-turn session metrics into a comparison table")
    report_parser.add_argument("--json", action="store_true", help="emit JSON instead of Markdown")
    report_parser.add_argument("--remote", default=None, help="tunnel profile, or local for the node's own API configuration (default: the fleet.toml remote, else local)")
    report_parser.add_argument("--wall", action="append", default=[], dest="walls", help="runner-measured wall seconds for a session as SESSION=SECONDS; may repeat")
    report_parser.add_argument("--since", default=None, help="include every task launched at or after this ISO 8601 time")
    report_parser.add_argument("--label", action="append", default=[], help="start a labeled group; repeat for side-by-side tables")
    report_parser.add_argument("--session", action="append", default=[], dest="sessions", help="report a session id directly; may repeat")
    report_parser.add_argument("tasks", nargs="*", help="tasky task ids (full id or six-character suffix)")
    args = parser.parse_args()
    try:
        if args.action == "benchmark":
            return benchmark(args)
        if args.action == "report":
            # argparse cannot keep the order of repeated --label groups, so the
            # report re-scans the raw tokens to know which ids belong together.
            raw = sys.argv[sys.argv.index("report") + 1:]
            return report_command(raw, load_reporting(args.remote), parse_wall_args(args.walls))
        config = load()
        if args.action == "launch":
            launch(args, config)
        elif args.action == "status":
            return status(config)
        elif args.action == "collect":
            collect(args.task_id, config)
        elif args.action == "resume":
            resume(args.task_id, args.message, config)
        elif args.action in ("release", "rm"):
            release(args.task_id, config, force=args.force)
        elif args.action == "kill":
            seconds = args.timeout_seconds if args.timeout_seconds is not None else float(config.get("kill_timeout_seconds", 60))
            if not math.isfinite(seconds) or seconds <= 0:
                raise ValueError("kill timeout must be positive")
            kill(args.task_id, config, seconds)
        else:
            reset(args.worker, config)
    except (RuntimeError, OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"fleet: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
